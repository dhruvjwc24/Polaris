# Google Places API (also used for Custom Search API — enable both in the same GCP project)
GOOGLE_PLACES_API_KEY=

# Tavily Search API — needed for contact discovery (web search for emails + social profiles)
# Free tier: 1,000 queries/month, no credit card required
# Sign up at https://tavily.com → Dashboard → API Keys
TAVILY_API_KEY=

# Brave Search — optional fallback if you prefer it over Tavily ($5/month)
# BRAVE_SEARCH_API_KEY=

# Meta / Facebook — needed for Facebook Pages search in contact discovery
# 1. Create an app at https://developers.facebook.com (Business type)
# 2. Generate an app access token: GET https://graph.facebook.com/oauth/access_token
#    ?client_id={APP_ID}&client_secret={APP_SECRET}&grant_type=client_credentials
META_APP_ACCESS_TOKEN=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Gmail OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Supabase (run: supabase start to get these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Calendly
CALENDLY_URL=

# SMS outreach (last resort when no email or social found) — message template to be configured
# SMS_MESSAGE_TEMPLATE=Hey {name}, I built you a quick site mockup — want to take a look?
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
